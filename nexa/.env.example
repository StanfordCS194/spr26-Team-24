# =============================================================================
# Nexa — Environment template
# =============================================================================
# Copy this file to .env.local and fill in real values before running `npm run
# dev`. NEVER commit .env.local. Production secrets live in Vercel — see
# VERCEL_SETUP.md.
# =============================================================================

# --- Database ---
# Local dev:  postgresql://nexa:nexa_dev_password@localhost:5433/nexa
# Production: paste the pooled connection string from Neon / Vercel Postgres
DATABASE_URL=

# --- Auth ---
# Generate with: openssl rand -base64 32
JWT_SECRET=

# --- LLM providers ---
# OpenAI is required for /api/reports/classify in production.
# Anthropic + Google are only needed on the llm-comparison branch.
# GOOGLE_API_KEY is the Gemini / Google AI key (classification) — distinct from
# GOOGLE_MAPS_API_KEY below.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# --- Maps / Places ---
# Optional. Enables Google Places address autocomplete in /api/location/suggest;
# falls back to Nominatim when unset. Separate key from GOOGLE_API_KEY above.
GOOGLE_MAPS_API_KEY=

# --- Telemetry (PostHog) ---
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# --- Email (Brevo) ---
# Create a free account at https://app.brevo.com, then generate an API key under
# Settings → SMTP & API → API Keys. BREVO_SENDER_EMAIL must be a verified sender.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=noreply@nexa.app

# --- Manual reminder job ---
# Protects POST /api/reports/send-follow-up-reminders. Generate with:
# openssl rand -base64 32
FOLLOW_UP_REMINDER_SECRET=

# --- Cron jobs ---
# Gates GET /api/cron/poll-status (the Open311 status-polling job in
# vercel.json). Vercel Cron attaches it as `Authorization: Bearer <secret>`.
# The route FAILS CLOSED: when this is unset/empty it returns 503 and does NOT
# poll, so the endpoint can never run unauthenticated. Generate with:
# openssl rand -base64 32
CRON_SECRET=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
